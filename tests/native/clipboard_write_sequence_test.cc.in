#define WIN32_LEAN_AND_MEAN
#include <windows.h>
#include <objbase.h>
#include <array>
#include <atomic>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <cwchar>
#include <cstdint>
#include <mutex>
#include <set>
#include <string>
#include <thread>
#include <vector>

static HWND g_window;
static int checks, failures;
static std::mutex allocations_lock;
static std::set<HGLOBAL> allocations;
static std::set<std::array<unsigned char, 16>> tokens;
static std::atomic<int> duplicate_tokens{0};
enum class Fault { None, Guid, Format, Allocate, LockWrite, Set, Reopen, LockRead, MissingRead };
static thread_local Fault fault = Fault::None;
static thread_local HGLOBAL receipt_memory;
static thread_local HGLOBAL read_receipt_memory;
static thread_local bool allocating_receipt, published_receipt, publication_closed;
static thread_local bool verify_read_close = true;
static thread_local int open_depth;
static thread_local void (*race_after_close)();
static UINT receipt_format;
static thread_local bool trace_calls, materialize_before_close, probe_foreign_while_open;
struct BoundaryCall { const char* name; long long result; DWORD error; int depth; HWND open_window; };
static thread_local std::vector<BoundaryCall> boundary_calls;
static void ProbeForeignWhileOpen();
static void RecordCall(const char* name, long long result, DWORD error) {
  if (trace_calls) boundary_calls.push_back({name, result, error, open_depth, GetOpenClipboardWindow()});
  SetLastError(error);
}
static void MaterializeFormats() {
  bool text = IsClipboardFormatAvailable(CF_UNICODETEXT) != 0;
  bool image = IsClipboardFormatAvailable(CF_DIB) != 0;
  for (UINT format : {CF_TEXT, CF_OEMTEXT, CF_LOCALE, CF_BITMAP, CF_DIBV5}) {
    if ((format == CF_TEXT || format == CF_OEMTEXT || format == CF_LOCALE) ? !text : !image) continue;
    DWORD before = GetClipboardSequenceNumber(); SetLastError(ERROR_SUCCESS);
    HANDLE value = GetClipboardData(format); DWORD error = GetLastError();
    std::printf("CLIP_MATERIALIZE format=%u handle=%p error=%lu before=%lu after=%lu open=%p\n",
        format, value, error, before, GetClipboardSequenceNumber(), (void*)GetOpenClipboardWindow());
  }
}

static void Check(bool value, const char* name) {
  ++checks;
  if (!value) { ++failures; std::printf("FAIL CLIP_SEQUENCE %s error=%lu\n", name, GetLastError()); }
}
static void ResetControl(Fault mode = Fault::None) {
  fault = mode; receipt_memory = nullptr; read_receipt_memory = nullptr; allocating_receipt = false;
  published_receipt = false; publication_closed = false; race_after_close = nullptr;
  Check(open_depth == 0, "previous writer released clipboard lock");
}
[[maybe_unused]] static HRESULT ObservedGuid(GUID* guid) {
  return fault == Fault::Guid ? E_FAIL : CoCreateGuid(guid);
}
static UINT ObservedFormat(LPCWSTR name) {
  if (std::wcscmp(name, L"Gesher.Clipboard.WriteReceipt.v1") == 0) {
    allocating_receipt = true;
    return fault == Fault::Format ? 0 : RegisterClipboardFormatW(name);
  }
  return RegisterClipboardFormatW(name);
}
static HGLOBAL ObservedAlloc(UINT flags, SIZE_T size) {
  bool metadata = allocating_receipt && size == 16;
  allocating_receipt = false;
  if (metadata && fault == Fault::Allocate) return nullptr;
  HGLOBAL memory = GlobalAlloc(flags, size);
  if (memory) { std::lock_guard<std::mutex> guard(allocations_lock); allocations.insert(memory); }
  if (metadata) receipt_memory = memory;
  return memory;
}
static LPVOID ObservedLock(HGLOBAL memory) {
  if (memory == receipt_memory && fault == Fault::LockWrite && !published_receipt) return nullptr;
  if (memory == read_receipt_memory && fault == Fault::LockRead && published_receipt) return nullptr;
  return GlobalLock(memory);
}
static HGLOBAL ObservedFree(HGLOBAL memory) {
  HGLOBAL remaining = GlobalFree(memory);
  if (!remaining) { std::lock_guard<std::mutex> guard(allocations_lock); allocations.erase(memory); }
  return remaining;
}
static HANDLE ObservedSet(UINT format, HANDLE memory) {
  if (format == receipt_format && fault == Fault::Set) return nullptr;
  SetLastError(ERROR_SUCCESS);
  HANDLE result = SetClipboardData(format, memory); DWORD error = GetLastError();
  if (result) {
    std::lock_guard<std::mutex> guard(allocations_lock);
    allocations.erase(memory);
    if (format == receipt_format) {
      published_receipt = true;
      const void* data = GlobalLock(memory);
      if (data) {
        std::array<unsigned char, 16> token;
        std::memcpy(token.data(), data, token.size());
        if (!tokens.insert(token).second) ++duplicate_tokens;
        GlobalUnlock(memory);
      }
    }
  }
  RecordCall("SetClipboardData", reinterpret_cast<intptr_t>(result), error);
  return result;
}
static BOOL ObservedOpen(HWND owner) {
  if (publication_closed && fault == Fault::Reopen) return FALSE;
  SetLastError(ERROR_SUCCESS);
  BOOL opened = OpenClipboard(owner); DWORD error = GetLastError();
  if (opened) ++open_depth;
  RecordCall("OpenClipboard", opened, error);
  return opened;
}
static BOOL ObservedEmpty() {
  SetLastError(ERROR_SUCCESS);
  BOOL empty = EmptyClipboard(); DWORD error = GetLastError();
  RecordCall("EmptyClipboard", empty, error);
  return empty;
}
static HANDLE ObservedGet(UINT format) {
  if (format == receipt_format && fault == Fault::MissingRead) return nullptr;
  HANDLE memory = GetClipboardData(format);
  if (format == receipt_format) read_receipt_memory = memory;
  return memory;
}
static BOOL ObservedClose() {
  bool measured = materialize_before_close && !publication_closed;
  if (measured) MaterializeFormats();
  if (probe_foreign_while_open && !publication_closed) {
    probe_foreign_while_open = false;
    ProbeForeignWhileOpen();
  }
  DWORD before = GetClipboardSequenceNumber();
  SetLastError(ERROR_SUCCESS);
  BOOL closed = CloseClipboard(); DWORD error = GetLastError();
  DWORD after = GetClipboardSequenceNumber();
  if (closed) --open_depth;
  RecordCall("CloseClipboard", closed, error);
  if (measured) std::printf("CLIP_MATERIALIZE close=%d error=%lu before=%lu after=%lu stable=%d\n", closed, error, before, after, before == after);
  if (!publication_closed) {
    publication_closed = true;
    auto race = race_after_close; race_after_close = nullptr;
    if (closed && race) race();
  } else if (closed && published_receipt && verify_read_close && before != after) {
    std::printf("FAIL CLIP_SEQUENCE read-only close changed sequence %lu -> %lu\n", before, after);
    ++duplicate_tokens;  // A thread-safe fatal boundary failure, never an accepted write receipt.
  }
  return closed;
}

#define CoCreateGuid ObservedGuid
#define RegisterClipboardFormatW ObservedFormat
#define GlobalAlloc ObservedAlloc
#define GlobalLock ObservedLock
#define GlobalFree ObservedFree
#define SetClipboardData ObservedSet
#define OpenClipboard ObservedOpen
#define EmptyClipboard ObservedEmpty
#define GetClipboardData ObservedGet
#define CloseClipboard ObservedClose
@RECEIPT@
namespace gesher { namespace devsvc {
unsigned long long StartEvents() { return reinterpret_cast<unsigned long long>(g_window); }
@DEV_WRITERS@
} namespace windows {
@RICH_WRITERS@
} }
#undef CoCreateGuid
#undef RegisterClipboardFormatW
#undef GlobalAlloc
#undef GlobalLock
#undef GlobalFree
#undef SetClipboardData
#undef OpenClipboard
#undef EmptyClipboard
#undef GetClipboardData
#undef CloseClipboard

static std::vector<uint8_t> Image() {
  std::vector<uint8_t> bytes(sizeof(BITMAPINFOHEADER) + 4);
  BITMAPINFOHEADER header{}; header.biSize = sizeof(header); header.biWidth = 1;
  header.biHeight = 1; header.biPlanes = 1; header.biBitCount = 32; header.biSizeImage = 4;
  std::memcpy(bytes.data(), &header, sizeof(header));
  bytes[sizeof(header)] = 0x12; bytes[sizeof(header) + 1] = 0x34; bytes[sizeof(header) + 2] = 0x56;
  return bytes;
}
static bool Write(int kind, uint32_t* sequence) {
  if (kind == 0) return gesher::devsvc::SetClipboard(u"own text", u"", sequence);
  if (kind == 1) return gesher::devsvc::SetClipboard(u"own text", u"<b>own text</b>", sequence);
  auto image = Image();
  return gesher::windows::WriteRichClipboard(u"own text", u"<b>own text</b>", image.data(), image.size(), sequence);
}
static void VerifyContent(int kind) {
  std::u16string text, html;
  Check(gesher::devsvc::ClipboardText(&text) && text == u"own text", "actual native text readback");
  bool has_html = gesher::devsvc::ClipboardHtml(&html);
  Check(kind == 0 ? !has_html : has_html && html == u"<b>own text</b>", "actual native HTML readback");
  std::vector<uint8_t> image;
  bool has_image = gesher::windows::ReadClipboardImage(&image);
  bool image_matches = false;
  if (has_image && image.size() >= 14 + sizeof(BITMAPINFOHEADER) + 4) {
    uint32_t offset; BITMAPINFOHEADER header;
    std::memcpy(&offset, image.data() + 10, sizeof(offset));
    std::memcpy(&header, image.data() + 14, sizeof(header));
    image_matches = image[0] == 'B' && image[1] == 'M' && header.biWidth == 1 && header.biHeight == 1
        && header.biPlanes == 1 && header.biBitCount == 32 && offset + 4 <= image.size()
        && image[offset] == 0x12 && image[offset + 1] == 0x34 && image[offset + 2] == 0x56;
  }
  Check(kind == 2 ? image_matches : !has_image, "actual native image pixels and geometry readback");
}
static void CheckResources() {
  { std::lock_guard<std::mutex> guard(allocations_lock); Check(allocations.empty(), "all untransferred allocations freed"); }
  Check(open_depth == 0, "writer and receipt read released every open");
  bool opened = OpenClipboard(nullptr) != 0;
  Check(opened, "real clipboard can be reopened after operation");
  if (opened) Check(CloseClipboard() != 0, "real resource-probe close");
}
static void SameOwnerReplacement() {
  uint32_t replaced = 0;
  publication_closed = false;
  Check(gesher::devsvc::SetClipboard(u"same owner replacement", u"", &replaced), "same-HWND competing actual write");
  Check(replaced != 0 && replaced == GetClipboardSequenceNumber(), "competing same-HWND receipt is current");
  Check(GetClipboardOwner() == g_window, "competing write retains identical owner HWND");
}
struct ForeignObservation { LONG opened, published; DWORD error; };
struct ForeignState { HANDLE ready{}, stop{}, process{}, mapping{}; ForeignObservation* observation{}; DWORD pid{}; };
static ForeignState foreign;
static bool clone_receipt;
static bool borrow_original_owner;
static bool foreign_during_open;
static bool raw_opened;
static bool RawWrite(HWND owner, const GUID* cloned) {
  raw_opened = false;
  if (!OpenClipboard(owner)) return false;
  raw_opened = true;
  bool ok = EmptyClipboard() != 0;
  const wchar_t text[] = L"external foreign writer";
  HGLOBAL memory = GlobalAlloc(GMEM_MOVEABLE, sizeof(text));
  if (!memory) ok = false;
  else {
    void* p = GlobalLock(memory);
    if (!p) { GlobalFree(memory); ok = false; }
    else { std::memcpy(p, text, sizeof(text)); GlobalUnlock(memory);
      if (!SetClipboardData(CF_UNICODETEXT, memory)) { GlobalFree(memory); ok = false; } }
  }
  if (cloned) {
    memory = GlobalAlloc(GMEM_MOVEABLE, sizeof(*cloned));
    if (!memory) ok = false;
    else { void* p = GlobalLock(memory);
      if (!p) { GlobalFree(memory); ok = false; }
      else { std::memcpy(p, cloned, sizeof(*cloned)); GlobalUnlock(memory);
        if (!SetClipboardData(receipt_format, memory)) { GlobalFree(memory); ok = false; } }
    }
  }
  return CloseClipboard() != 0 && ok;
}
static void StartForeignReplacement() {
  wchar_t executable[32768];
  Check(GetModuleFileNameW(nullptr, executable, 32768) != 0, "owned child executable path");
  std::wstring suffix = std::to_wstring(GetCurrentProcessId()) + L"_" + std::to_wstring(GetTickCount64());
  std::wstring ready_name = L"Local\\GesherClipboardReady_" + suffix;
  std::wstring stop_name = L"Local\\GesherClipboardStop_" + suffix;
  std::wstring map_name = L"Local\\GesherClipboardObservation_" + suffix;
  foreign.ready = CreateEventW(nullptr, TRUE, FALSE, ready_name.c_str());
  foreign.stop = CreateEventW(nullptr, TRUE, FALSE, stop_name.c_str());
  foreign.mapping = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0, sizeof(ForeignObservation), map_name.c_str());
  foreign.observation = foreign.mapping ? static_cast<ForeignObservation*>(MapViewOfFile(foreign.mapping, FILE_MAP_ALL_ACCESS, 0, 0, sizeof(ForeignObservation))) : nullptr;
  Check(foreign.ready && foreign.stop, "owned child synchronization handles");
  Check(foreign.observation != nullptr, "owned child observation mapping");
  if (foreign.observation) *foreign.observation = {-1, -1, 0};
  std::wstring token = L"none";
  if (clone_receipt) {
    if (!foreign_during_open) Check(OpenClipboard(nullptr) != 0, "read original token for foreign-owner negative");
    HANDLE memory = GetClipboardData(receipt_format);
    const unsigned char* bytes = memory ? static_cast<const unsigned char*>(GlobalLock(memory)) : nullptr;
    Check(bytes != nullptr && GlobalSize(memory) == 16, "original receipt available for owner negative");
    if (bytes) { token.clear(); const wchar_t hex[] = L"0123456789abcdef";
      for (int i = 0; i < 16; ++i) { token += hex[bytes[i] >> 4]; token += hex[bytes[i] & 15]; } GlobalUnlock(memory); }
    if (!foreign_during_open) Check(CloseClipboard() != 0, "original token read close");
  }
  std::wstring command = L"\"" + std::wstring(executable) + L"\" --foreign " + ready_name + L" " + stop_name + L" " + token
      + L" " + map_name + L" " + std::to_wstring(borrow_original_owner ? reinterpret_cast<uintptr_t>(g_window) : 0);
  STARTUPINFOW startup{}; startup.cb = sizeof(startup); PROCESS_INFORMATION process{};
  bool started = CreateProcessW(nullptr, command.data(), nullptr, nullptr, FALSE, 0, nullptr, nullptr, &startup, &process) != 0;
  Check(started, "real external writer process creation");
  if (!started) return;
  foreign.process = process.hProcess; foreign.pid = process.dwProcessId;
  Check(CloseHandle(process.hThread) != 0, "child thread handle retired");
  Check(WaitForSingleObject(foreign.ready, 10000) == WAIT_OBJECT_0, "external writer completed before receipt reopen");
  DWORD owner_pid = 0; HWND owner = GetClipboardOwner(); GetWindowThreadProcessId(owner, &owner_pid);
  Check(foreign.observation && foreign.observation->opened >= 0 && foreign.observation->published >= 0, "actual foreign OpenClipboard and publication outcomes");
  if (!borrow_original_owner) {
    Check(foreign.observation && foreign.observation->opened == 1 && foreign.observation->published == 1, "ordinary foreign writer actually published");
    Check(owner && owner != g_window && owner_pid == foreign.pid && owner_pid != GetCurrentProcessId(), "actual foreign owner PID and HWND");
  } else {
    Check(foreign.observation && (foreign.observation->opened == 0 || foreign.observation->published == 1), "borrowed-HWND probe either rejected at OpenClipboard or actually published");
  }
  FILETIME created, exited, kernel, user;
  Check(GetProcessTimes(foreign.process, &created, &exited, &kernel, &user) != 0, "external writer native creation identity");
  std::printf("CLIP_SEQUENCE foreign pid=%lu created=%08lx%08lx hwnd=%p cloned=%d borrowed=%d opened=%ld published=%ld error=%lu\n",
      foreign.pid, created.dwHighDateTime, created.dwLowDateTime, (void*)owner, clone_receipt, borrow_original_owner,
      foreign.observation ? foreign.observation->opened : -1L, foreign.observation ? foreign.observation->published : -1L,
      foreign.observation ? foreign.observation->error : 0);
}
static void StopForeign() {
  if (foreign.process) {
    Check(SetEvent(foreign.stop) != 0, "signal owned external writer retirement");
    DWORD waited = WaitForSingleObject(foreign.process, 10000), code = 0;
    Check(waited == WAIT_OBJECT_0, "owned external writer retired within deadline");
    if (waited != WAIT_OBJECT_0) { TerminateProcess(foreign.process, 90); WaitForSingleObject(foreign.process, 5000); }
    Check(GetExitCodeProcess(foreign.process, &code) && code == 0, "external writer data and resource result");
    Check(CloseHandle(foreign.process) != 0, "owned child process handle closed");
  }
  if (foreign.ready) Check(CloseHandle(foreign.ready) != 0, "owned ready event closed");
  if (foreign.stop) Check(CloseHandle(foreign.stop) != 0, "owned stop event closed");
  if (foreign.observation) Check(UnmapViewOfFile(foreign.observation) != 0, "owned observation view closed");
  if (foreign.mapping) Check(CloseHandle(foreign.mapping) != 0, "owned observation mapping closed");
  foreign = {};
}
static void ProbeForeignWhileOpen() {
  foreign_during_open = true; clone_receipt = true; borrow_original_owner = true;
  StartForeignReplacement();
  Check(foreign.observation && foreign.observation->opened == 0,
        "foreign borrowed HWND cannot join the still-held publication lock");
  std::printf("CLIP_LOCK_EXCLUSION opened=%ld published=%ld error=%lu\n",
      foreign.observation ? foreign.observation->opened : -1L, foreign.observation ? foreign.observation->published : -1L,
      foreign.observation ? foreign.observation->error : 0);
  StopForeign(); foreign_during_open = false;
}
static int Child(const char* ready_name, const char* stop_name, const char* token, const char* map_name, const char* borrowed_owner) {
  HANDLE ready = OpenEventA(EVENT_MODIFY_STATE, FALSE, ready_name), stop = OpenEventA(SYNCHRONIZE, FALSE, stop_name);
  HANDLE mapping = OpenFileMappingA(FILE_MAP_ALL_ACCESS, FALSE, map_name);
  auto* observation = mapping ? static_cast<ForeignObservation*>(MapViewOfFile(mapping, FILE_MAP_ALL_ACCESS, 0, 0, sizeof(ForeignObservation))) : nullptr;
  if (!ready || !stop || !observation) return 20;
  GUID copied{}; GUID* clone = nullptr;
  if (std::strlen(token) == 32) {
    auto* bytes = reinterpret_cast<unsigned char*>(&copied);
    for (int i = 0; i < 16; ++i) { char pair[3] = {token[i * 2], token[i * 2 + 1], 0}; bytes[i] = static_cast<unsigned char>(std::strtoul(pair, nullptr, 16)); }
    clone = &copied;
  }
  HWND owner = CreateWindowExW(0, L"STATIC", L"Owned external clipboard control", 0, 0, 0, 0, 0, HWND_MESSAGE, nullptr, GetModuleHandleW(nullptr), nullptr);
  HWND borrowed = reinterpret_cast<HWND>(static_cast<uintptr_t>(std::strtoull(borrowed_owner, nullptr, 10)));
  SetLastError(ERROR_SUCCESS);
  bool wrote = owner && RawWrite(borrowed ? borrowed : owner, clone);
  DWORD error = GetLastError();
  *observation = {raw_opened ? 1L : 0L, wrote ? 1L : 0L, error};
  bool ok = owner && (wrote || (borrowed && !raw_opened)) && SetEvent(ready);
  if (ok) ok = WaitForSingleObject(stop, 30000) == WAIT_OBJECT_0;
  if (owner) ok = DestroyWindow(owner) && ok;
  ok = CloseHandle(ready) && ok; ok = CloseHandle(stop) && ok;
  ok = UnmapViewOfFile(observation) && ok; ok = CloseHandle(mapping) && ok;
  return ok ? 0 : 21;
}
int main(int argc, char** argv) {
  receipt_format = RegisterClipboardFormatW(L"Gesher.Clipboard.WriteReceipt.v1");
  if (argc == 7 && std::strcmp(argv[1], "--foreign") == 0) return Child(argv[2], argv[3], argv[4], argv[5], argv[6]);
  bool old = argc == 2 && std::strcmp(argv[1], "--old-control") == 0;
  HANDLE window_ready = CreateEventW(nullptr, TRUE, FALSE, nullptr);
  HANDLE owner_done = CreateEventW(nullptr, TRUE, FALSE, nullptr);
  if (!window_ready || !owner_done || !receipt_format) return 10;
  DWORD owner_thread_id = 0; std::atomic<bool> owner_retired{false};
  // Production owns this HWND on its independently pumped event thread. A
  // foreign EmptyClipboard can synchronously notify it while the writer waits.
  std::thread owner_thread([&] {
    owner_thread_id = GetCurrentThreadId();
    HWND owner = CreateWindowExW(0, L"STATIC", L"Owned production clipboard contract", 0, 0, 0, 0, 0, HWND_MESSAGE, nullptr, GetModuleHandleW(nullptr), nullptr);
    g_window = owner; SetEvent(window_ready);
    if (owner) {
      MSG message;
      while (GetMessageW(&message, nullptr, 0, 0) > 0) { TranslateMessage(&message); DispatchMessageW(&message); }
      owner_retired = DestroyWindow(owner) != 0 && !IsWindow(owner);
    }
    SetEvent(owner_done);
  });
  Check(WaitForSingleObject(window_ready, 10000) == WAIT_OBJECT_0, "real owner event thread created its window");
  Check(CloseHandle(window_ready) != 0, "owner startup event closed");
  if (!g_window) { owner_thread.join(); CloseHandle(owner_done); return 10; }
  for (int kind = 0; kind < 3; ++kind) {
    ResetControl(); uint32_t sequence = 0;
    bool ok = Write(kind, &sequence);
    DWORD after = GetClipboardSequenceNumber();
    std::printf("CLIP_SEQUENCE case=%d success=%d receipt=%lu current=%lu owner=%p\n", kind, ok, (unsigned long)sequence, after, (void*)GetClipboardOwner());
    Check(ok, "real native publication succeeds");
    Check(sequence != 0 && sequence == after, "receipt matches completed native publication");
    VerifyContent(kind); CheckResources();
    Check(after == GetClipboardSequenceNumber(), "read-only closes do not change final sequence");
  }
  if (!old) {
    ResetControl();
    HWND saved_owner = g_window; g_window = nullptr; uint32_t unavailable = 99;
    Check(!Write(2, &unavailable) && unavailable == 0, "rich publication fails closed without its real event window");
    g_window = saved_owner; CheckResources();
    for (int kind : {0, 2}) {
      ResetControl(); race_after_close = SameOwnerReplacement; uint32_t sequence = 99;
      Check(Write(kind, &sequence), "original write completed before same-owner race");
      Check(sequence == 0, "same HWND replacement must not inherit original Android source");
      std::u16string text; Check(gesher::devsvc::ClipboardText(&text) && text == u"same owner replacement", "same-owner actual replacement remains readable");
      CheckResources();
      for (int foreign_case : {0, 1, 2}) {
        ResetControl(); clone_receipt = foreign_case != 0; borrow_original_owner = foreign_case == 2;
        race_after_close = StartForeignReplacement; sequence = 99;
        Check(Write(kind, &sequence), "original write completed before foreign race");
        bool rejected_open = foreign.observation && borrow_original_owner && foreign.observation->opened == 0;
        if (rejected_open) {
          Check(sequence != 0 && sequence == GetClipboardSequenceNumber(), "OS-rejected borrowed HWND preserves original publication");
          Check(gesher::devsvc::ClipboardText(&text) && text == u"own text", "OS-rejected borrowed HWND leaves original content intact");
        } else {
          Check(sequence == 0, "foreign writer must not inherit original Android source");
          Check(gesher::devsvc::ClipboardText(&text) && text == u"external foreign writer", "actual external contents remain readable");
        }
        StopForeign(); CheckResources();
      }
      for (Fault failure : {Fault::Guid, Fault::Format, Fault::Allocate, Fault::LockWrite, Fault::Set, Fault::Reopen, Fault::LockRead, Fault::MissingRead}) {
        ResetControl(failure); sequence = 99;
        Check(Write(kind, &sequence), "data publication remains honest when attribution metadata unavailable");
        Check(sequence == 0, "failed metadata/reopen must not invent a publication receipt");
        fault = Fault::None; VerifyContent(kind); CheckResources();
      }
    }
    std::atomic<int> write_errors{0};
    std::atomic<int> write_rejections{0}, depth_errors{0};
    auto concurrent = [&](int kind) {
      verify_read_close = false;  // A competing writer may run immediately after this read releases its lock.
      trace_calls = true;
      for (int i = 0; i < 16; ++i) {
        fault = Fault::None; publication_closed = false; receipt_memory = nullptr; read_receipt_memory = nullptr;
        allocating_receipt = false; published_receipt = false;
        boundary_calls.clear();
        uint32_t sequence = 0;
        ULONGLONG started = GetTickCount64();
        bool wrote = Write(kind, &sequence); DWORD error = GetLastError();
        if (!wrote || open_depth != 0) ++write_errors;
        if (!wrote) ++write_rejections;
        if (open_depth != 0) ++depth_errors;
        std::string events;
        for (const auto& event : boundary_calls) {
          char text[200];
          std::snprintf(text, sizeof(text), " %s(result=%lld,error=%lu,depth=%d,open=%p)", event.name, event.result, event.error, event.depth, (void*)event.open_window);
          events += text;
        }
        std::printf("CLIP_CONCURRENT tid=%lu kind=%d index=%d success=%d receipt=%lu depth=%d error=%lu elapsed=%llu%s\n",
            GetCurrentThreadId(), kind, i, wrote, (unsigned long)sequence, open_depth, error, GetTickCount64() - started, events.c_str());
      }
    };
    std::thread first(concurrent, 0), second(concurrent, 2); first.join(); second.join();
    std::printf("CLIP_CONCURRENT totals rejected=%d depth_errors=%d combined=%d\n", write_rejections.load(), depth_errors.load(), write_errors.load());
    Check(write_errors == 0, "concurrent plain/rich writes release their native resources");
    Check(duplicate_tokens == 0 && tokens.size() >= 40, "full per-write GUID uniqueness across helpers and concurrent same-HWND writers");
    ResetControl(); uint32_t cleared = 99;
    Check(gesher::devsvc::SetClipboard(u"", u"", &cleared), "clear publication succeeds");
    Check(cleared == 0 && CountClipboardFormats() == 0, "clear has no private receipt or public formats");
    std::u16string text, html; std::vector<uint8_t> image;
    Check(!gesher::devsvc::ClipboardText(&text) && !gesher::devsvc::ClipboardHtml(&html)
          && !gesher::windows::ReadClipboardImage(&image), "clear preserves absent text HTML and image");
    CheckResources();
    for (int kind = 0; kind < 3; ++kind) {
      ResetControl(); materialize_before_close = true; uint32_t sequence = 0;
      std::printf("CLIP_MATERIALIZE begin kind=%d\n", kind);
      Check(Write(kind, &sequence), "format synthesis measurement still publishes actual data");
      materialize_before_close = false; VerifyContent(kind); CheckResources();
    }
    ResetControl(); probe_foreign_while_open = true; uint32_t exclusive_sequence = 0;
    Check(Write(0, &exclusive_sequence), "held-lock probe leaves real own publication intact");
    Check(exclusive_sequence != 0 && exclusive_sequence == GetClipboardSequenceNumber(), "held-lock exclusion preserves own current receipt");
    VerifyContent(0); CheckResources();
  }
  Check(PostThreadMessageW(owner_thread_id, WM_QUIT, 0, 0) != 0, "owned event thread retirement posted");
  if (WaitForSingleObject(owner_done, 5000) != WAIT_OBJECT_0) {
    std::printf("FAIL CLIP_SEQUENCE owner event thread exceeded retirement deadline\n");
    std::fflush(stdout); ExitProcess(12);
  }
  owner_thread.join();
  Check(CloseHandle(owner_done) != 0, "owner retirement event closed");
  Check(owner_retired && !IsWindow(g_window), "owned publication window and event thread retired");
  std::printf("CLIP_SEQUENCE completed checks=%d failures=%d unique_receipts=%zu old=%d\n", checks, failures, tokens.size(), old);
  return failures || duplicate_tokens ? 1 : 0;
}
